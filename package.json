{
  "name": "logic-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Adapter-independent world simulation core with a versioned HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --import ./tests/configure-test-env.js --test",
    "benchmark:replay": "node benchmarks/replay-rollback-growth.mjs",
    "install:extension": "node scripts/install-logic-engine-extension.mjs",
    "host:patch:preflight": "node scripts/sillytavern-patch-manager.mjs preflight",
    "host:patch:install": "node scripts/sillytavern-patch-manager.mjs install",
    "host:patch:verify": "node scripts/sillytavern-patch-manager.mjs verify",
    "host:patch:repair": "node scripts/sillytavern-patch-manager.mjs repair",
    "host:patch:update": "node scripts/sillytavern-patch-manager.mjs update",
    "host:patch:uninstall": "node scripts/sillytavern-patch-manager.mjs uninstall"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
