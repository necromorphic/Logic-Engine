+/**
+ * Re-key an imported/copied JSONL chat so copied source IDs cannot masquerade as
+ * identities in the destination chat. Source IDs are retained as provenance only.
+ * A copy does not inherit a claim that its lifecycle inventory is complete.
+ */
+function logicEngineRekeyImportedChatJsonl(data) {
+    const lines = data.split('\n').filter(line => line.trim() !== '');
+    if (!lines.length) throw new Error('Imported chat is empty.');
+    const records = lines.map(line => JSON.parse(line));
+    const header = records[0];
+    if (!header || typeof header !== 'object') throw new Error('Imported chat header is invalid.');
+    const metadata = header.chat_metadata ??= {};
+    const sourceLifecycle = metadata.logic_engine_lifecycle;
+    const sourceChatId = sourceLifecycle?.chat_id ?? metadata.integrity ?? null;
+    metadata.logic_engine_lifecycle = {
+        schema_version: 1,
+        chat_id: crypto.randomUUID(),
+        source_chat_id: sourceChatId,
+        source_lifecycle: sourceLifecycle ? {
+            schema_version: sourceLifecycle.schema_version,
+            chat_id: sourceLifecycle.chat_id ?? sourceChatId,
+            inventory_complete: sourceLifecycle.inventory_complete === true,
+            event_count: Array.isArray(sourceLifecycle.events) ? sourceLifecycle.events.length : null,
+            history_truncated: sourceLifecycle.history_truncated === true,
+        } : null,
+        inventory_complete: false,
+        events: [],
+    };
+
+    for (const message of records.slice(1)) {
+        if (!message || typeof message !== 'object') continue;
+        message.logic_engine_source_message_id = message.logic_engine_message_id ?? null;
+        message.logic_engine_source_version_id = message.logic_engine_version_id ?? null;
+        message.logic_engine_message_id = crypto.randomUUID();
+        message.logic_engine_version_id = crypto.randomUUID();
+        if (Array.isArray(message.swipes)) {
+            if (!Array.isArray(message.swipe_info)) message.swipe_info = [];
+            for (let i = 0; i < message.swipes.length; i++) {
+                if (!message.swipe_info[i] || typeof message.swipe_info[i] !== 'object') message.swipe_info[i] = {};
+                message.swipe_info[i].logic_engine_source_version_id = message.swipe_info[i].logic_engine_version_id ?? null;
+                message.swipe_info[i].logic_engine_version_id = crypto.randomUUID();
+            }
+            message.logic_engine_version_id = message.swipe_info[message.swipe_id ?? 0]?.logic_engine_version_id ?? message.logic_engine_version_id;
+        }
+    }
+    return records.map(record => JSON.stringify(record)).join('\n') + '\n';
+}
