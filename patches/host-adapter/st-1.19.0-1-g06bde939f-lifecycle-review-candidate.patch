+/**
+ * REVIEW CANDIDATE: durable, chat-embedded lifecycle history.
+ * This is intentionally fail-closed: the history never claims to cover events
+ * that happened before installation or while the source was unavailable.
+ */
+function logicEngineLifecycle() {
+    chat_metadata.logic_engine_lifecycle ??= {
+        schema_version: 1,
+        chat_id: chat_metadata.integrity ?? uuidv4(),
+        source_chat_id: null,
+        inventory_complete: false,
+        events: [],
+    };
+    const lifecycle = chat_metadata.logic_engine_lifecycle;
+    if (lifecycle.schema_version !== 1 || !Array.isArray(lifecycle.events)) {
+        lifecycle.inventory_complete = false;
+        throw new Error('Unsupported Logic-Engine lifecycle metadata; refusing to mutate it.');
+    }
+    return lifecycle;
+}
+
+function logicEngineRecordLifecycle(action, message, details = {}) {
+    const lifecycle = logicEngineLifecycle();
+    message.logic_engine_message_id ??= uuidv4();
+    const versionId = details.versionId ?? message.logic_engine_version_id ?? uuidv4();
+    const event = {
+        event_id: uuidv4(),
+        action,
+        at: Date.now(),
+        message_id: message.logic_engine_message_id,
+        version_id: versionId,
+        parent_version_id: details.parentVersionId ?? null,
+        text: details.text ?? message.mes ?? null,
+        snapshot: details.snapshot ? structuredClone(message) : undefined,
+        version_ids: details.versionIds,
+        target_version_id: details.targetVersionId,
+        target_text: details.targetText,
+        source_message_id: details.sourceMessageId,
+        source_version_id: details.sourceVersionId,
+    };
+    lifecycle.events.push(event);
+    // This proposal never claims a complete historical inventory. In particular,
+    // an existing/legacy chat can have versions deleted before this code runs.
+    lifecycle.inventory_complete = false;
+    return event;
+}
+
+function logicEngineStartVersion(message, action, parentVersionId = null) {
+    message.logic_engine_message_id ??= uuidv4();
+    const previousVersionId = parentVersionId ?? message.logic_engine_version_id ?? null;
+    const versionId = uuidv4();
+    message.logic_engine_version_id = versionId;
+    logicEngineRecordLifecycle(action, message, {
+        versionId,
+        parentVersionId: previousVersionId,
+        snapshot: true,
+    });
+    return versionId;
+}
+
+async function logicEngineReconcileLoadedChat() {
+    let changed = false;
+    const lifecycleWasPresent = Boolean(chat_metadata.logic_engine_lifecycle);
+    const lifecycle = logicEngineLifecycle();
+    if (!lifecycleWasPresent) changed = true;
+
+    for (const message of chat) {
+        if (!message || typeof message !== 'object') {
+            lifecycle.inventory_complete = false;
+            continue;
+        }
+        const hadMessageId = Boolean(message.logic_engine_message_id);
+        const hadVersionId = Boolean(message.logic_engine_version_id);
+        message.logic_engine_message_id ??= uuidv4();
+
+        if (!message.is_user && Array.isArray(message.swipes)) {
+            if (!Array.isArray(message.swipe_info)) message.swipe_info = [];
+            for (let i = 0; i < message.swipes.length; i++) {
+                if (!message.swipe_info[i] || typeof message.swipe_info[i] !== 'object') {
+                    message.swipe_info[i] = {};
+                }
+                if (!message.swipe_info[i].logic_engine_version_id) {
+                    message.swipe_info[i].logic_engine_version_id = uuidv4();
+                    changed = true;
+                }
+            }
+            const current = message.swipe_info[message.swipe_id ?? 0];
+            if (current?.logic_engine_version_id) {
+                message.logic_engine_version_id = current.logic_engine_version_id;
+            }
+        }
+        if (!message.logic_engine_version_id) {
+            message.logic_engine_version_id = uuidv4();
+            changed = true;
+        }
+        if (!hadMessageId || !hadVersionId) {
+            logicEngineRecordLifecycle('legacy-migration', message, { snapshot: true });
+            changed = true;
+        }
+    }
+    // Migration creates identities for the surviving current state only. It cannot
+    // reconstruct deleted versions, old edits, or changes missed while offline.
+    lifecycle.inventory_complete = false;
+    if (changed) await saveChatConditional();
+}
