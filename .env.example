ENGINE_API_TOKEN=replace-with-a-random-secret-at-least-16-characters
ENGINE_APPROVAL_TOKEN=replace-with-a-separate-random-secret-at-least-16-characters
ENGINE_ADMIN_TOKEN=replace-with-a-separate-admin-secret-at-least-16-characters
ENGINE_INTERNAL_TOKEN=replace-with-a-separate-internal-secret-at-least-16-characters
ENGINE_ADAPTER_TOKENS={"sillytavern-main":"replace-with-a-random-adapter-secret-at-least-16-characters"}
ENGINE_DB_PATH=./data/logic-engine.sqlite
LOGIC_ENGINE_COORDINATOR_DB_PATH=/absolute/path/to/logic-engine-coordinator.sqlite
ENGINE_HOST_VERSION_LEDGER_DB_PATH=./data/logic-engine-host-versions.sqlite
ENGINE_HOST_ASSERTION_NONCE_DB_PATH=./data/logic-engine-host-assertion-nonces.sqlite
# Optional cross-process Memory -> NPC retrieval; requires a durable provider DB and explicit field allowlist.
# ENGINE_MEMORY_PROVIDER_DB_PATH=./data/logic-engine-memory.sqlite
# ENGINE_MEMORY_NPC_CONTENT_FIELDS=["attributes.public_note"]
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8787
ENGINE_ALLOW_REMOTE=false
ENGINE_TRUSTED_INITIAL_KNOWLEDGE_SOURCES=[]
LOGIC_ENGINE_WORLD_PACK_CATALOG_PATH=/absolute/path/to/deployment-controlled/world-pack-catalog.json
ENGINE_HOST_LIFECYCLE_DB_PATH=./data/logic-engine-host-lifecycle.sqlite
ENGINE_HOST_ROOT_IDENTITIES=[]
# Required only when deployment enables lifecycle receipt authority.
ENGINE_HOST_AUTHORITY_ID=replace-with-deployment-authority-id
ENGINE_HOST_AUTHORITY_GENERATION=1

# SillyTavern Extension Gateway process environment.
# Both directories must be absolute and outside SillyTavern's global DATA_ROOT.
LOGIC_ENGINE_HOST_IDENTITY_DIR=/absolute/path/outside/SillyTavern-DATA_ROOT/logic-engine-host-identity
LOGIC_ENGINE_HOST_RECEIPT_DIR=/absolute/path/outside/SillyTavern-DATA_ROOT/logic-engine-host-receipts
# Deployment claim checked against the pinned Host source target; not runtime attestation.
LOGIC_ENGINE_HOST_BUILD_SHA=06bde939fb1e9c4c8d8641d810f0a916b5bce127
LOGIC_ENGINE_CORE_URL=http://127.0.0.1:8787
LOGIC_ENGINE_API_TOKEN=replace-with-Core-API-token
LOGIC_ENGINE_ADAPTER_ID=sillytavern-main
LOGIC_ENGINE_ADAPTER_TOKEN=replace-with-adapter-token
