+let logicEngineHostSessionPromise;
+async function getLogicEngineHostSession() {
+    if (!logicEngineHostSessionPromise) {
+        logicEngineHostSessionPromise = fetch('/api/logic-engine/host/session', {
+            credentials: 'same-origin',
+            cache: 'no-store',
+        }).then(async response => {
+            if (!response.ok) throw Error('Host authenticated session identity unavailable');
+            const payload = await response.json();
+            if (typeof payload?.host_session_id !== 'string'
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(payload.host_session_id)
+                || payload?.host_session_identity !== 'SIGNED_AUTHENTICATED_ST_SESSION'
+                || typeof payload?.host_user_handle !== 'string') {
+                throw Error('Host authenticated session identity is malformed');
+            }
+            return payload;
+        }).catch(error => {
+            logicEngineHostSessionPromise = null;
+            throw error;
+        });
+    }
+    return logicEngineHostSessionPromise;
+}
+
+async function getLogicEngineHostSessionId() {
+    return (await getLogicEngineHostSession()).host_session_id;
+}
+
+let logicEngineHostIdentityPromise;
+async function getLogicEngineHostIdentity() {
+    if (!logicEngineHostIdentityPromise) {
+        logicEngineHostIdentityPromise = getLogicEngineHostSession().then(async session => {
+            const response = await fetch('/api/logic-engine/host/identity', {
+                credentials: 'same-origin',
+                cache: 'no-store',
+            });
+            if (!response.ok) throw Error('Server-persisted Host identity unavailable');
+            const identity = await response.json();
+            if (identity?.host_session_id !== session.host_session_id
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(identity.host_installation_id)
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(identity.authenticated_account_id)
+                || identity.identity_source !== 'SERVER_PERSISTED_OPAQUE_IDENTITY') {
+                throw Error('Server-persisted Host identity is malformed or belongs to another session');
+            }
+            return identity;
+        }).catch(error => {
+            logicEngineHostIdentityPromise = null;
+            throw error;
+        });
+    }
+    return logicEngineHostIdentityPromise;
+}
+let logicEngineLifecyclePendingRenameId = null;
+async function getLogicEngineConversationId() {
+    const hostSessionId = await getLogicEngineHostSessionId();
+    const result = await resolveStableHostConversationIdentity({
+        locator: getCurrentChatId(),
+        hostSessionId,
+        metadata: chat_metadata,
+        storage: localStorage,
+        saveMetadata: () => saveChatConditional(),
+        getCurrentLocator: getCurrentChatId,
+        getCurrentMetadata: () => chat_metadata,
+        pendingRenameId: logicEngineLifecyclePendingRenameId,
+    });
+    return result.status === 'NON_READY' ? null : result.conversationId;
+}
+
+let logicEngineLifecycleBridgePromise;
+async function getLogicEngineLifecycleBridge() {
+    if (!logicEngineLifecycleBridgePromise) {
+        logicEngineLifecycleBridgePromise = getLogicEngineHostIdentity().then(identity => HostLifecycleJournal.open({
+            hostInstallationId: identity.host_installation_id,
+            authenticatedAccountId: identity.authenticated_account_id,
+        })).then(journal => createStLifecycleBridge({
+            journal,
+            getConversationId: getLogicEngineConversationId,
+            getSourceLocator: getCurrentChatId,
+            getChat: () => chat,
+            saveChat: () => saveChatConditional(),
+            getPersistedInventory: async () => {
+                const session = await getLogicEngineHostSession();
+                const conversationId = await getLogicEngineConversationId();
+                const conversationUuid = conversationId?.split(':').at(-1);
+                if (!conversationUuid) throw Error('Host conversation identity unavailable for persisted inventory');
+                const response = await fetch('/api/logic-engine/host/inventory?conversation_uuid=' + encodeURIComponent(conversationUuid), {
+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                if (!response.ok) {
+                    logicEngineHostSessionPromise = null;
+                    throw Error('Persisted Host inventory unavailable');
+                }
+                const inventory = await response.json();
+                if (inventory?.host_user_handle !== session.host_user_handle) {
+                    logicEngineHostSessionPromise = null;
+                    throw Error('Persisted Host inventory belongs to a different authenticated account');
+                }
+                return {
+                    ...inventory,
+                    host_session_id: session.host_session_id,
+                    host_session_identity: session.host_session_identity,
+                    authenticated_user_handle: session.host_user_handle,
+                };
+            },
+            publishSnapshot: async snapshot => {
+                const response = await fetch('/api/logic-engine/host-version-ledger/reconcile', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify(snapshot),
+                });
+                const payload = await response.json().catch(() => null);
+                if (response.status === 409 && payload?.inventory_status === 'NON_READY') return payload;
+                if (!response.ok) {
+                    const code = typeof payload?.error?.code === 'string' ? ' (' + payload.error.code + ')' : '';
+                    throw Error('Core inventory reconciliation rejected with HTTP ' + response.status + code);
+                }
+                return payload;
+            },
+            publishLifecycleEvent: async event => {
+                const response = await fetch('/api/logic-engine/host-lifecycle/events', {
+                    method: 'POST',
+                    credentials: 'same-origin',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify(event),
+                });
+                const payload = await response.json().catch(() => null);
+                if (!response.ok) {
+                    const code = typeof payload?.error?.code === 'string' ? ' (' + payload.error.code + ')' : '';
+                    throw Error('Core lifecycle journal rejected event with HTTP ' + response.status + code);
+                }
+                return payload;
+            },
+            getLifecycleStatus: async conversationId => {
+                const response = await fetch('/api/logic-engine/host-lifecycle/status?conversation_id='
+                    + encodeURIComponent(conversationId), {
+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                const payload = await response.json().catch(() => null);
+                if (!response.ok || !payload?.lifecycle) {
+                    throw Error('Core lifecycle journal status unavailable');
+                }
+                return payload.lifecycle;
+            },
+        })).catch(async error => {
+            if (hasAnyHostEnrollment(localStorage)) throw Error('NON_READY: enrolled Host journal or authenticated session identity unavailable: ' + error.message);
+            return createUnavailableStLifecycleBridge({
+                getConversationId: getLogicEngineConversationId,
+                storage: localStorage,
+                error,
+            });
+        });
+    }
+    return logicEngineLifecycleBridgePromise;
+}
+
+// Explicit development-only enrollment; no chat is enrolled automatically.
+if (typeof window !== 'undefined') {
+    window.logicEngineHostLifecycle = {
+        guardOperation: async (operation, messageIndexes = [], details = {}) =>
+            (await getLogicEngineLifecycleBridge()).beforeMutation(operation, messageIndexes, details),
+        completeOperation: async (operation, details = {}) =>
+            (await getLogicEngineLifecycleBridge()).afterMutation(operation, details),
+        guardChatLocatorMutation: async locator => {
+            if (hostLocatorHasEnrollment(locator, localStorage)) {
+                throw Error('NON_READY: enrolled chat locator mutation requires an identity-preserving lifecycle handler');
+            }
+            return { status: 'NOT_ENROLLED' };
+        },
+        guardChatLocatorDeletion: async locator => {
+            if (hostLocatorHasEnrollment(locator, localStorage)) {
+                throw Error('NON_READY: target chat requires a tombstone-aware deletion handler');
+            }
+            return { status: 'NOT_ENROLLED' };
+        },
+        guardBulkMutation: async () => {
+            if (hasAnyHostEnrollment(localStorage)) {
+                throw Error('NON_READY: bulk mutation requires a complete enrolled-chat inventory');
+            }
+            return { status: 'NO_ENROLLED_HOST_CHATS' };
+        },
+        enrollCurrentConversation: async () => {
+            const sourceLocator = getCurrentChatId();
+            const conversationId = await getLogicEngineConversationId();
+            if (!conversationId || !sourceLocator) throw Error('NON_READY: no active Host conversation');
+            localStorage.setItem('logic-engine-host-lifecycle-locator:' + sourceLocator, conversationId);
+            const marker = 'logic-engine-host-lifecycle:' + conversationId;
+            localStorage.setItem(marker, 'enrolling:' + sourceLocator);
+            try {
+                const result = await (await getLogicEngineLifecycleBridge()).enrollCurrentConversation();
+                if (getCurrentChatId() !== sourceLocator) throw Error('NON_READY: Host conversation changed during enrollment');
+                localStorage.setItem(marker, 'enrolled:' + sourceLocator);
+                return result;
+            } catch (error) {
+                localStorage.setItem(marker, 'NON_READY:' + sourceLocator);
+                throw error;
+            }
+        },
+        syncCurrentDigestInventory: async () =>
+            (await getLogicEngineLifecycleBridge()).syncCurrentDigestInventory(),
+        verifyPersistedInventory: async () =>
+            (await getLogicEngineLifecycleBridge()).verifyPersistedInventory(),
+        reconcileCurrentConversation: async () =>
+            (await getLogicEngineLifecycleBridge()).reconcileCurrentConversation(),
+        getCoreCaptureStatus: async () =>
+            (await getLogicEngineLifecycleBridge()).getCoreCaptureStatus(),
+    };
+}
