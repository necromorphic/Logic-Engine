+// The first instrumented mutation establishes a review-only baseline automatically.
+let logicEngineEnrollmentBarrier = null;
+if (typeof window !== 'undefined') {
+    window.logicEngineHostLifecycle = {
+        waitForEnrollment: async () => {
+            const pending = logicEngineEnrollmentBarrier;
+            if (pending) await pending;
+        },
+        getDiagnostics: async () => ({
+            lastHostDiagnostic: logicEngineHostDiagnostic,
+            lifecycle: await (await getLogicEngineLifecycleBridge()).getCoreCaptureStatus?.() ?? { status: 'UNAVAILABLE' },
+        }),
+        guardOperation: async (operation, messageIndexes = [], details = {}) =>
+            (await getLogicEngineLifecycleBridge()).beforeMutation(operation, messageIndexes, details),
+        completeOperation: async (operation, details = {}) =>
+            (await getLogicEngineLifecycleBridge()).afterMutation(operation, details),
+        guardChatLocatorMutation: async () => ({ status: 'NOT_ENROLLED' }),
+        guardChatLocatorDeletion: async () => ({ status: 'NOT_ENROLLED' }),
+        guardBulkMutation: async () => ({ status: 'NOT_ENROLLED' }),
+        enrollCurrentConversation: async () => {
+            if (logicEngineEnrollmentBarrier) throw Error('NON_READY: enrollment already in progress');
+            let releaseEnrollment;
+            const barrier = new Promise(resolve => { releaseEnrollment = resolve; });
+            logicEngineEnrollmentBarrier = barrier;
+            const sourceLocator = getCurrentChatId();
+            let conversationId = null;
+            try {
+                conversationId = await getLogicEngineConversationId();
+                if (!conversationId || !sourceLocator || getCurrentChatId() !== sourceLocator) {
+                    throw Error('NON_READY: Host conversation changed before enrollment');
+                }
+                localStorage.setItem('logic-engine-host-lifecycle-locator:' + sourceLocator, conversationId);
+                const marker = 'logic-engine-host-lifecycle:' + conversationId;
+                localStorage.setItem(marker, 'enrolling:' + sourceLocator);
+                try {
+                    if (getCurrentChatId() !== sourceLocator) throw Error('NON_READY: Host conversation changed before enrollment');
+                    const result = await (await getLogicEngineLifecycleBridge()).enrollCurrentConversation();
+                    if (getCurrentChatId() !== sourceLocator) throw Error('NON_READY: Host conversation changed during enrollment');
+                    localStorage.setItem(marker, 'enrolled:' + sourceLocator);
+                    return result;
+                } catch (error) {
+                    localStorage.setItem(marker, 'NON_READY:' + sourceLocator);
+                    throw error;
+                }
+            } finally {
+                if (logicEngineEnrollmentBarrier === barrier) logicEngineEnrollmentBarrier = null;
+                releaseEnrollment();
+            }
+        },
+        syncCurrentDigestInventory: async () => {
+            try { return await (await getLogicEngineLifecycleBridge()).syncCurrentDigestInventory(); }
+            catch (error) {
+                console.warn('Logic Engine digest sync unavailable; continuing native SillyTavern operation.', error?.message || error);
+                return { status: 'NOT_ENROLLED' };
+            }
+        },
+        verifyPersistedInventory: async () => {
+            try { return await (await getLogicEngineLifecycleBridge()).verifyPersistedInventory(); }
+            catch (error) {
+                console.warn('Logic Engine inventory verification unavailable; continuing native SillyTavern operation.', error?.message || error);
+                return { status: 'NOT_ENROLLED' };
+            }
+        },
+        reconcileCurrentConversation: async () => {
+            try { return await (await getLogicEngineLifecycleBridge()).reconcileCurrentConversation(); }
+            catch (error) {
+                console.warn('Logic Engine reconciliation unavailable; continuing native SillyTavern operation.', error?.message || error);
+                return { status: 'NOT_ENROLLED' };
+            }
+        },
+        guardExport: async () =>
+            (await getLogicEngineLifecycleBridge()).guardExport(),
+        getCoreCaptureStatus: async () => {
+            try { return await (await getLogicEngineLifecycleBridge()).getCoreCaptureStatus(); }
+            catch (error) {
+                console.warn('Logic Engine capture status unavailable; continuing native SillyTavern operation.', error?.message || error);
+                return { status: 'NOT_ENROLLED' };
+            }
+        },
+    };
+}
