+            (await getLogicEngineLifecycleBridge()).syncCurrentDigestInventory(),
+        verifyPersistedInventory: async () =>
+            (await getLogicEngineLifecycleBridge()).verifyPersistedInventory(),
+        reconcileCurrentConversation: async () =>
