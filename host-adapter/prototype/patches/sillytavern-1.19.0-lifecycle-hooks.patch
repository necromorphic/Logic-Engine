+            cache: 'no-store',
+        }).then(async response => {
+            if (!response.ok) throw Error('Host authenticated session identity unavailable');
+            const payload = await response.json();
+            if (typeof payload?.host_session_id !== 'string'
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(payload.host_session_id)
+                || payload?.host_session_identity !== 'SIGNED_AUTHENTICATED_ST_SESSION'
+                || typeof payload?.host_user_handle !== 'string') {
+                throw Error('Host authenticated session identity is malformed');
+            }
+            return payload;
+        }).catch(error => {
+            invalidateLogicEngineHostIdentity();
+            throw error;
+        });
+    }
+    return logicEngineHostSessionPromise;
+}
+
+let logicEngineHostIdentityPromise;
+function invalidateLogicEngineHostIdentity() {
+    logicEngineHostSessionPromise = null;
+    logicEngineHostIdentityPromise = null;
+    logicEngineLifecycleBridgePromise = null;
+}
+async function getLogicEngineHostIdentity() {
+    if (!logicEngineHostIdentityPromise) {
+        logicEngineHostIdentityPromise = getLogicEngineHostSession().then(async session => {
+            const response = await fetch('/api/plugins/logic-engine-extension-gateway/identity', {
+                credentials: 'same-origin',
+                cache: 'no-store',
+            });
+            if (!response.ok) throw Error('Server-persisted Host identity unavailable');
+            const identity = await response.json();
+            if (identity?.host_session_id !== session.host_session_id
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(identity.host_installation_id)
+                || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(identity.authenticated_account_id)
+                || identity.identity_source !== 'SERVER_PERSISTED_OPAQUE_IDENTITY') {
+                throw Error('Server-persisted Host identity is malformed or belongs to another session');
+            }
+            return identity;
+        }).catch(error => {
+            invalidateLogicEngineHostIdentity();
+            throw error;
+        });
+    }
+    return logicEngineHostIdentityPromise;
+}
+let logicEngineLifecyclePendingRenameId = null;
