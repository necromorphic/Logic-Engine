+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                const payload = await response.json().catch(() => null);
+                if (!response.ok || !payload?.lifecycle) {
+                    throw Error('Core lifecycle journal status unavailable');
+                }
+                return payload.lifecycle;
+            },
+        })).catch(async error => {
+            if (hasAnyHostEnrollment(localStorage)) throw Error('NON_READY: enrolled Host journal or authenticated session identity unavailable: ' + error.message);
+            return createUnavailableStLifecycleBridge({
+                getConversationId: getLogicEngineConversationId,
+                storage: localStorage,
+                error,
+            });
+        });
+    }
+    return logicEngineLifecycleBridgePromise;
+}
