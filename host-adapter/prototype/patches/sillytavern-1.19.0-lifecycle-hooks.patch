--- /dev/null
+++ b/src/endpoints/logic-engine-lifecycle.js
@@ -0,0 +1,100 @@
+import express from 'express';
+import { createHostDigestProxyHandler } from './logic-engine-lifecycle-proxy.mjs';
+import { scanHostArtifactRoots } from './logic-engine-host-inventory.mjs';
+import { getHostConversationInventory, getHostMutationJournalStatus, reconcileHostMutation, recordHostCaptureAcknowledgement, recordHostCaptureConflict, registerHostConversation } from './logic-engine-host-journal.mjs';
+
+export const router = express.Router();
+router.post('/host-version-ledger/capture', createHostDigestProxyHandler({
+    onAcceptedCapture: recordHostCaptureAcknowledgement,
+    onRejectedCapture: recordHostCaptureConflict,
+}));
+
+// Explicit server-side enrollment; browser-local markers are not server authority.
+router.post('/host-lifecycle/enroll', async (request, response) => {
+    try {
+        if (typeof request.body?.sourcePath !== 'string') {
+            return response.status(400).json({ error: { code: 'HOST_ENROLLMENT_SOURCE_PATH_REQUIRED' } });
+        }
+        const result = await registerHostConversation(request, request.body ?? {});
+        return response.status(200).json(result);
+    } catch (error) {
+        const code = typeof error?.message === 'string' && error.message.startsWith('HOST_ENROLLMENT_')
+            ? error.message
+            : 'HOST_ENROLLMENT_UNAVAILABLE';
+        return response.status(code === 'HOST_ENROLLMENT_UNAVAILABLE' ? 503 : 400).json({ error: { code } });
+    }
+});
+
+router.post('/host-lifecycle/status', async (request, response) => {
+    try {
+        return response.status(200).json(await getHostMutationJournalStatus(request));
