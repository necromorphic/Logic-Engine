+let logicEngineLifecyclePendingRenameId = null;
+let logicEngineHostDiagnostic = null;
+async function getLogicEngineConversationId() {
+    try {
+        const session = await getLogicEngineHostSession();
+        const identity = await getLogicEngineHostIdentity();
+        const hostSessionId = identity.host_session_id;
+        const result = await resolveStableHostConversationIdentity({
+            locator: getCurrentChatId(),
+            hostSessionId,
+            hostInstallationId: identity.host_installation_id,
+            authenticatedAccountId: identity.authenticated_account_id,
+            metadata: chat_metadata,
+            storage: localStorage,
+            saveMetadata: () => saveChatConditional(),
+            getCurrentLocator: getCurrentChatId,
+            getCurrentMetadata: () => chat_metadata,
+            pendingRenameId: logicEngineLifecyclePendingRenameId,
+            verifyPersistedIdentity: async conversationUuid => {
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/inventory?conversation_uuid='
+                    + encodeURIComponent(conversationUuid), {
+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                const payload = await response.json().catch(() => null);
+                return response.ok
+                    && payload?.host_user_handle === session.host_user_handle
+                    && payload?.requested_conversation_uuid === conversationUuid
+                    && Array.isArray(payload?.files)
+                    && payload.files.length === 1
+                    && payload.files[0]?.logical_identity?.conversation_uuid === conversationUuid;
+            },
+        });
+        logicEngineHostDiagnostic = null;
+        return result.status === 'NON_READY' ? null : result.conversationId;
+    } catch (error) {
+        const message = String(error?.message || '');
+        const classifications = [
+            [/locator binding and enrollment marker|recovery pair/i, 'HOST_ENROLLMENT_RECOVERY_PAIR_INVALID'],
+            [/marker does not match the active locator/i, 'HOST_ENROLLMENT_MARKER_LOCATOR_MISMATCH'],
+            [/locator is associated with another conversation identity/i, 'HOST_ENROLLMENT_IDENTITY_COLLISION'],
+            [/server confirmation is required/i, 'HOST_ENROLLMENT_SERVER_CONFIRMATION_REQUIRED'],
+            [/server did not confirm/i, 'HOST_ENROLLMENT_PERSISTENCE_MISMATCH'],
+            [/legacy.*marker|legacy identity migration/i, 'HOST_LEGACY_ENROLLMENT_MARKER_CONFLICT'],
+            [/locator metadata.*inconsistent|locator is bound/i, 'HOST_LOCATOR_BINDING_MISMATCH'],
+            [/already enrolled elsewhere|already mapped to another locator|duplicated or associated elsewhere/i, 'HOST_ENROLLMENT_IDENTITY_COLLISION'],
+            [/stable metadata identity/i, 'HOST_ENROLLMENT_METADATA_MISSING'],
+            [/malformed stable Host conversation identity/i, 'HOST_CONVERSATION_METADATA_INVALID'],
+        ];
+        const match = classifications.find(([pattern]) => pattern.test(message));
+        const code = match?.[1] || 'HOST_CONVERSATION_IDENTITY_UNAVAILABLE';
+        let enrollmentMarkerCount = 0;
+        let locatorBindingCount = 0;
+        try {
+            for (let index = 0; index < localStorage.length; index++) {
+                const key = localStorage.key(index);
+                if (key?.startsWith('logic-engine-host-lifecycle:')) enrollmentMarkerCount++;
+                if (key?.startsWith('logic-engine-host-lifecycle-locator:')) locatorBindingCount++;
+            }
+        } catch { /* diagnostics must not turn storage denial into a native ST failure */ }
+        let currentLocatorBindingPresent = false;
+        try {
+            currentLocatorBindingPresent = localStorage.getItem(
+                'logic-engine-host-lifecycle-locator:' + getCurrentChatId(),
+            ) !== null;
+        } catch { /* keep the diagnostic available when browser storage is denied */ }
+        logicEngineHostDiagnostic = Object.freeze({
+            status: 'NON_READY',
+            stage: 'CONVERSATION_IDENTITY',
+            code,
+            conversationMetadataPresent: typeof chat_metadata?.logic_engine_conversation_id === 'string',
+            currentLocatorBindingPresent,
+            enrollmentMarkerCount,
+            locatorBindingCount,
+            observedAt: new Date().toISOString(),
+        });
+        console.warn('Logic Engine Host diagnostic', logicEngineHostDiagnostic);
+        const diagnosticError = Error('NON_READY: ' + code);
+        diagnosticError.code = code;
+        throw diagnosticError;
+    }
+}
