+import express from 'express';
+import { createHostDigestProxyHandler } from './logic-engine-lifecycle-proxy.mjs';
+import { scanHostArtifactRoots } from './logic-engine-host-inventory.mjs';
+
+export const router = express.Router();
+router.post('/host-version-ledger/capture', createHostDigestProxyHandler());
+
+// Authenticated, digest-only current snapshot of persisted Host chat/backup artifacts.
+// This is not an all-time history proof or an authorization signal.
+router.post('/host-artifact-inventory/scan', async (request, response) => {
+    const roots = [
+        { domain: 'chats', path: request.user?.directories?.chats },
+        { domain: 'groups', path: request.user?.directories?.groups },
+        { domain: 'group_chats', path: request.user?.directories?.groupChats },
+        { domain: 'backups', path: request.user?.directories?.backups },
+    ];
+    if (roots.some(root => typeof root.path !== 'string' || !root.path)) {
+        return response.status(503).json({
+            status: 'INVENTORY_INCOMPLETE',
+            complete: false,
+            historicalCompleteness: 'UNKNOWN',
+            authority: 'NON_AUTHORITATIVE',
+            artifacts: [],
+            artifactCount: null,
+            errors: ['Host chat/group/backup storage roots are unavailable'],
+        });
+    }
+    try {
+        const result = await scanHostArtifactRoots(roots);
+        return response.status(result.complete ? 200 : 503).json(result);
+    } catch {
+        return response.status(503).json({
+            status: 'INVENTORY_INCOMPLETE',
+            complete: false,
+            historicalCompleteness: 'UNKNOWN',
+            authority: 'NON_AUTHORITATIVE',
+            artifacts: [],
+            artifactCount: null,
+            errors: ['Host inventory scan failed'],
+        });
+    }
+});
