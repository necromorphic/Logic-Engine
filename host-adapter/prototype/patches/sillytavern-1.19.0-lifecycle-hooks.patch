+                const payload = await response.json().catch(() => null);
+                if (response.status === 409 && payload?.inventory_status === 'NON_READY') return payload;
+                if (!response.ok) {
+                    const code = typeof payload?.error?.code === 'string' ? ' (' + payload.error.code + ')' : '';
+                    throw Error('Core inventory reconciliation rejected with HTTP ' + response.status + code);
+                }
+                return payload;
+            },
+            publishLifecycleEvent: async event => {
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/host-lifecycle/events', {
