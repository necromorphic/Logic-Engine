+const locks = new Map();
+async function acquireUserLock(key) {
+    const prior = locks.get(key) ?? Promise.resolve();
+    let release;
+    const current = new Promise(resolve => { release = resolve; });
+    const tail = prior.then(() => current);
+    locks.set(key, tail);
+    await prior;
+    return () => {
+        release();
+        if (locks.get(key) === tail) locks.delete(key);
+    };
