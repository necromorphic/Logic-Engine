+function wrapNativeSafeLifecycleBridge(bridge) {
+    const safe = async (label, callback, nativeFallback = true) => {
+        try {
+            return await callback();
+        } catch (error) {
+            const code = typeof error?.code === 'string' && /^[A-Z0-9_]{1,96}$/.test(error.code)
+                ? error.code : 'HOST_LIFECYCLE_OBSERVATION_UNAVAILABLE';
+            const diagnostic = Object.freeze({
+                status: 'NON_READY',
+                stage: label,
+                code,
+                observedAt: new Date().toISOString(),
+            });
+            logicEngineHostDiagnostic = diagnostic;
+            console.warn('Logic Engine Host diagnostic', diagnostic);
+            console.warn('Logic Engine lifecycle observer unavailable; continuing native SillyTavern operation.');
+            if (nativeFallback) {
+                return { status: 'NOT_ENROLLED', reason: 'LIFECYCLE_OBSERVATION_UNAVAILABLE' };
+            }
+            return diagnostic;
+        }
+    };
+    return {
+        ...bridge,
+        beforeMutation: (...args) => safe('lifecycle preparation', () => bridge.beforeMutation(...args)),
+        afterMutation: (...args) => safe('lifecycle receipt', () => bridge.afterMutation(...args)),
+        syncCurrentDigestInventory: (...args) => safe('digest sync', () => bridge.syncCurrentDigestInventory(...args), false),
+        verifyPersistedInventory: (...args) => safe('inventory verification', () => bridge.verifyPersistedInventory(...args), false),
+        reconcileCurrentConversation: (...args) => safe('conversation reconciliation', () => bridge.reconcileCurrentConversation(...args), false),
+        // Native SillyTavern export remains available if optional lifecycle
+        // observation is unavailable; server-side protected mutation gates remain authoritative.
+        guardExport: (...args) => safe('export verification', () => bridge.guardExport(...args)),
+        getCoreCaptureStatus: (...args) => safe('capture status', () => bridge.getCoreCaptureStatus(...args), false),
+    };
+}
