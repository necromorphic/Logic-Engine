@@ -0,0 +1,77 @@
+import express from 'express';
+import { createHostDigestProxyHandler } from './logic-engine-lifecycle-proxy.mjs';
+import { scanHostArtifactRoots } from './logic-engine-host-inventory.mjs';
+import { getHostMutationJournalStatus, reconcileHostMutation, registerHostConversation } from './logic-engine-host-journal.mjs';
+
+export const router = express.Router();
+router.post('/host-version-ledger/capture', createHostDigestProxyHandler());
+
+// Explicit server-side enrollment; browser-local markers are not server authority.
+router.post('/host-lifecycle/enroll', async (request, response) => {
+    try {
+        const result = await registerHostConversation(request, request.body ?? {});
+        return response.status(200).json(result);
+    } catch (error) {
+        const code = typeof error?.message === 'string' && error.message.startsWith('HOST_ENROLLMENT_')
+            ? error.message
+            : 'HOST_ENROLLMENT_UNAVAILABLE';
+        return response.status(code === 'HOST_ENROLLMENT_UNAVAILABLE' ? 503 : 400).json({ error: { code } });
+    }
+});
++
+router.post('/host-lifecycle/status', async (request, response) => {
+    try {
+        return response.status(200).json(await getHostMutationJournalStatus(request));
+    } catch {
+        return response.status(503).json({ error: { code: 'HOST_JOURNAL_UNAVAILABLE' } });
+    }
+});
+
+// Explicit human acknowledgement only; this records a gap and never restores READY.
+router.post('/host-lifecycle/reconcile', async (request, response) => {
+    try {
+        const result = await reconcileHostMutation(request, request.body ?? {});
+        return response.status(200).json(result);
+    } catch (error) {
+        const code = typeof error?.message === 'string' && error.message.startsWith('HOST_RECONCILIATION_')
+            ? error.message
+            : 'HOST_RECONCILIATION_UNAVAILABLE';
+        return response.status(code === 'HOST_RECONCILIATION_UNAVAILABLE' ? 503 : 400).json({ error: { code } });
+    }
+});
+
+// Authenticated, digest-only current snapshot of persisted Host artifacts.
+// This is not an all-time history proof or an authorization signal.
+router.post('/host-artifact-inventory/scan', async (request, response) => {
+    const roots = [
+        { domain: 'chats', path: request.user?.directories?.chats },
+        { domain: 'groups', path: request.user?.directories?.groups },
+        { domain: 'group_chats', path: request.user?.directories?.groupChats },
+        { domain: 'backups', path: request.user?.directories?.backups },
+    ];
+    if (roots.some(root => typeof root.path !== 'string' || !root.path)) {
+        return response.status(503).json({
+            status: 'INVENTORY_INCOMPLETE',
+            complete: false,
+            historicalCompleteness: 'UNKNOWN',
+            authority: 'NON_AUTHORITATIVE',
+            artifacts: [],
+            artifactCount: null,
+            errors: ['Host chat/group/backup storage roots are unavailable'],
+        });
