+let logicEngineLifecycleBridgePromise;
+async function getLogicEngineLifecycleBridge() {
+    if (!logicEngineLifecycleBridgePromise) {
+        logicEngineLifecycleBridgePromise = HostLifecycleJournal.open().then(journal => createStLifecycleBridge({
+            journal,
+            getConversationId: getCurrentChatId,
+            getChat: () => chat,
+            saveChat: () => saveChatConditional(),
+        })).catch(error => {
+            const marker = 'logic-engine-host-lifecycle:' + getCurrentChatId();
+            if (localStorage.getItem(marker)) throw Error('NON_READY: enrolled Host journal unavailable: ' + error.message);
+            return createUnavailableStLifecycleBridge({
+                getConversationId: getCurrentChatId,
+                storage: localStorage,
+                error,
+            });
+        });
+    }
+    return logicEngineLifecycleBridgePromise;
+}
+
+// Explicit development-only enrollment; no chat is enrolled automatically.
+if (typeof window !== 'undefined') {
+    window.logicEngineHostLifecycle = {
+        enrollCurrentConversation: async () => {
+            const conversationId = getCurrentChatId();
+            const marker = 'logic-engine-host-lifecycle:' + conversationId;
+            localStorage.setItem(marker, 'enrolling');
+            try {
+                const result = await (await getLogicEngineLifecycleBridge()).enrollCurrentConversation();
+                localStorage.setItem(marker, 'enrolled');
+                return result;
+            } catch (error) {
+                localStorage.setItem(marker, 'NON_READY');
+                throw error;
+            }
+        },
+    };
+}
