+            getPersistedInventory: async () => {
+                const session = await getLogicEngineHostSession();
+                const conversationId = await getLogicEngineConversationId();
+                const conversationUuid = conversationId?.split(':').at(-1);
+                if (!conversationUuid) throw Error('Host conversation identity unavailable for persisted inventory');
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/inventory?conversation_uuid=' + encodeURIComponent(conversationUuid), {
+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                const inventory = await response.json().catch(() => null);
+                if (!response.ok) {
+                    const error = Error('Persisted Host inventory request failed');
+                    const serverCode = typeof inventory?.error?.code === 'string' ? inventory.error.code
+                        : typeof inventory?.code === 'string' ? inventory.code : null;
+                    const serverReason = typeof inventory?.reason === 'string' ? inventory.reason : null;
+                    error.code = serverCode && /^[A-Z0-9_]{1,96}$/.test(serverCode)
+                        ? serverCode : 'HOST_INVENTORY_HTTP_' + response.status;
+                    if (serverReason && /^[A-Z0-9_:-]{1,128}$/.test(serverReason)) error.reasonCode = serverReason;
+                    error.httpStatus = response.status;
+                    if ((!serverCode && [401, 403].includes(response.status))
+                        || (serverCode && /^HOST_(?:SESSION_|AUTHENTICATED_CONTEXT|USER_IDENTITY)/.test(serverCode))) {
+                        invalidateLogicEngineHostIdentity();
+                    }
+                    throw error;
+                }
+                if (!inventory || typeof inventory !== 'object' || Array.isArray(inventory)) {
+                    const error = Error('Persisted Host inventory response is malformed');
+                    error.code = 'HOST_INVENTORY_RESPONSE_INVALID';
+                    throw error;
+                }
+                if (inventory.host_user_handle !== session.host_user_handle) {
+                    invalidateLogicEngineHostIdentity();
+                    throw Error('Persisted Host inventory belongs to a different authenticated account');
+                }
+                return {
+                    ...inventory,
+                    host_session_id: session.host_session_id,
+                    host_session_identity: session.host_session_identity,
+                    authenticated_user_handle: session.host_user_handle,
+                };
+            },
+            publishSnapshot: async snapshot => {
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/host-version-ledger/reconcile', {
+                    method: 'POST',
+                    headers: { ...getRequestHeaders(), 'Content-Type': 'application/json' },
+                    body: JSON.stringify(snapshot),
+                });
+                const payload = await response.json().catch(() => null);
+                if (response.status === 409 && payload?.inventory_status === 'NON_READY') return payload;
+                if (!response.ok) {
+                    const code = typeof payload?.error?.code === 'string' ? ' (' + payload.error.code + ')' : '';
+                    throw Error('Core inventory reconciliation rejected with HTTP ' + response.status + code);
+                }
+                return payload;
+            },
+            publishLifecycleEvent: async event => {
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/host-lifecycle/events', {
+                    method: 'POST',
+                    credentials: 'same-origin',
+                    headers: { ...getRequestHeaders(), 'Content-Type': 'application/json' },
+                    body: JSON.stringify(event),
+                });
+                const payload = await response.json().catch(() => null);
+                if (!response.ok) {
+                    const code = typeof payload?.error?.code === 'string' ? ' (' + payload.error.code + ')' : '';
+                    throw Error('Core lifecycle journal rejected event with HTTP ' + response.status + code);
+                }
+                return payload;
+            },
+            getLifecycleStatus: async conversationId => {
+                const response = await fetch('/api/plugins/logic-engine-extension-gateway/host-lifecycle/status?conversation_id='
+                    + encodeURIComponent(conversationId), {
+                    credentials: 'same-origin',
+                    cache: 'no-store',
+                });
+                const payload = await response.json().catch(() => null);
+                if (!response.ok || !payload?.lifecycle) {
+                    throw Error('Core lifecycle journal status unavailable');
+                }
+                return payload.lifecycle;
+            },
+        }))).catch(async error => {
+            console.warn('Logic Engine lifecycle storage unavailable; continuing native SillyTavern operations.', error?.message || error);
+            return createUnavailableStLifecycleBridge({
+                getConversationId: async () => null,
+                storage: null,
+                error,
+            });
+        });
+    }
+    return logicEngineLifecycleBridgePromise;
+}
