+        })).catch(async error => {
+            if (hostLocatorHasEnrollment(getCurrentChatId(), localStorage)) throw Error('NON_READY: enrolled Host journal or authenticated session identity unavailable: ' + error.message);
+            return createUnavailableStLifecycleBridge({
+                getConversationId: getLogicEngineConversationId,
