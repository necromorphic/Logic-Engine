+                else skippedUnenrolledMutations.set(operation, count - 1);
+                return true;
+            };
+
+            return Object.freeze({
+                ...bridge,
+                beforeMutation: async (operation, ...args) => {
+                    if (!hostLocatorHasEnrollment(getCurrentChatId(), localStorage)) {
+                        markSkipped(operation);
+                        return { status: 'NOT_ENROLLED' };
+                    }
+                    return bridge.beforeMutation(operation, ...args);
+                },
+                afterMutation: async (operation, ...args) => {
+                    if (consumeSkipped(operation)) return { status: 'NOT_ENROLLED' };
+                    if (!hostLocatorHasEnrollment(getCurrentChatId(), localStorage)) return { status: 'NOT_ENROLLED' };
