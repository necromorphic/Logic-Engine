[Unit]
Description=Logic-Engine application (unprivileged SQLite client)
After=network.target logic-engine-sqlite-broker.service
Requires=logic-engine-sqlite-broker.service
Wants=network.target

[Service]
Type=simple
User=logic-engine-app
Group=logic-engine-app
WorkingDirectory=/opt/logic-engine
Environment=NODE_ENV=production
Environment=LOGIC_ENGINE_STATE_DIR=/var/lib/logic-engine
EnvironmentFile=-/etc/logic-engine/logic-engine.env
EnvironmentFile=/etc/logic-engine/sqlite-broker.env
ExecStart=/usr/bin/node /opt/logic-engine/src/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StateDirectory=logic-engine
StateDirectoryMode=0700
ReadWritePaths=/var/lib/logic-engine /var/lib/logic-engine-sqlite-alias

[Install]
WantedBy=multi-user.target
