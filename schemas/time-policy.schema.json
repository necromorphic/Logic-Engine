{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logic-engine.local/schemas/time-policy.schema.json",
  "title": "Logic-Engine TimePolicy",
  "description": "Declarative duration rules and protective limits. Runtime validation additionally enforces unique event_type rules and whole-second execution compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "max_action_duration_ms", "max_skip_duration_ms", "duration_rules"],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 200 },
    "max_action_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 604800000, "multipleOf": 1000 },
    "max_skip_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 604800000, "multipleOf": 1000 },
    "duration_rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_type", "rule"],
        "properties": {
          "event_type": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rule": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "duration_ms"],
                "properties": {
                  "kind": { "const": "fixed" },
                  "duration_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "min_duration_ms", "max_duration_ms", "resolution"],
                "properties": {
                  "kind": { "const": "range" },
                  "min_duration_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
                  "max_duration_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 },
                  "resolution": { "enum": ["midpoint", "author"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "categories"],
                "properties": {
                  "kind": { "const": "category_map" },
                  "categories": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["category", "duration_ms"],
                      "properties": {
                        "category": { "type": "string", "minLength": 1, "maxLength": 200 },
                        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 604800000 }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}