{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logic-engine.invalid/schemas/world-pack-manifest.schema.json",
  "title": "World Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world_pack_id",
    "version",
    "schema_version",
    "display_name",
    "capabilities",
    "entity_types",
    "relation_types",
    "action_types",
    "process_types",
    "knowledge_channels",
    "unknown_mechanics_policy"
  ],
  "properties": {
    "world_pack_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "entity_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeDefinition"
      }
    },
    "relation_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeDefinition"
      }
    },
    "action_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionDefinition"
      }
    },
    "process_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processDefinition"
      }
    },
    "knowledge_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "source_kind", "validation_policy"],
        "properties": {
          "channel_id": {"type": "string", "minLength": 1},
          "source_kind": {"type": "string", "minLength": 1},
          "validation_policy": {
            "enum": ["require_delivery", "require_observation", "require_document", "declared_inference", "author_seeded", "custom_rule"]
          },
          "description": {"type": "string"}
        }
      }
    },
    "story_arcs": {
      "type": "array",
      "items": {"type": "object"}
    },
    "story_beats": {
      "type": "array",
      "items": {"type": "object"}
    },
    "time_policy": {
      "type": "object",
      "description": "Only fields explicitly allowed by the pinned core contract may override default scheduling policy."
    },
    "unknown_mechanics_policy": {
      "enum": ["block", "needs_review", "author_adjudication", "declared_fallback"]
    },
    "conformance_tests": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "typeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_id", "attributes_schema"],
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$"
        },
        "description": {"type": "string"},
        "attributes_schema": {"type": "object"},
        "constraints": {
          "type": "array",
          "items": {"$ref": "declarative-rule.schema.json#/$defs/rule"}
        }
      }
    },
    "actionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "input_schema", "preconditions", "effects", "ambiguity_policy"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "input_schema": {"type": "object"},
        "preconditions": {
          "type": "array",
          "items": {"$ref": "declarative-rule.schema.json#/$defs/rule"}
        },
        "effects": {
          "type": "array",
          "items": {"$ref": "declarative-rule.schema.json#/$defs/effectIntent"}
        },
        "ambiguity_policy": {
          "enum": ["deterministic_only", "model_proposal_then_validate", "author_adjudication", "unsupported"]
        },
        "rollback_policy": {
          "enum": ["recompute", "invalidate_if_exclusive", "conflict_on_ambiguity"]
        }
      }
    },
    "processDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_type_id", "stages", "completion_policy"],
      "properties": {
        "process_type_id": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_id", "transitions"],
            "properties": {
              "stage_id": {"type": "string", "minLength": 1},
              "duration": {"type": ["object", "null"]},
              "prerequisites": {
                "type": "array",
                "items": {"$ref": "declarative-rule.schema.json#/$defs/rule"}
              },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["to_stage", "when"],
                  "properties": {
                    "to_stage": {"type": "string", "minLength": 1},
                    "when": {"$ref": "declarative-rule.schema.json#/$defs/rule"},
                    "effects": {
                      "type": "array",
                      "items": {"$ref": "declarative-rule.schema.json#/$defs/effectIntent"}
                    }
                  }
                }
              }
            }
          }
        },
        "completion_policy": {
          "enum": ["postcondition", "terminal_stage", "author_adjudication"]
        },
        "rollback_policy": {
          "enum": ["recompute_from_valid_prerequisites", "invalidate_exclusive_progress", "needs_review"]
        }
      }
    }
  }
}